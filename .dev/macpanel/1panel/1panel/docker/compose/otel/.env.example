# Copy to .env and fill in secrets (never commit .env).

# --- OpenObserve root user (UI login + collector Basic auth) ---
# Password: at least 16 chars, mixed case, digits, symbols; not equal to email local-part.
OO_ROOT_EMAIL=admin@example.com
OO_ROOT_PASSWORD=change-me-strong-password

# base64("email:password") — no "Basic " prefix
# macOS/Linux: echo -n 'admin@example.com:YourSecurePassword' | base64
OO_BASIC_AUTH=CHANGE_ME_BASE64_EMAIL_COLON_PASSWORD

# OpenObserve organization slug (ingest path /api/{org})
OO_ORG=default

# Optional stream name for documentation / future routing
OO_STREAM=default

# Host bind addresses (127.0.0.1 only in compose; change only if firewall-protected)
OPENOBSERVE_UI_PORT=5080
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
