# Copy these lines into compose/cellp/.env (merge with existing S3/port vars).
# OpenObserve / collector credentials live in ../otel/.env — see ../otel/.env.example

# --- cellp / cellpd (AD-14 OTLP ingest via collector) ---
# Traces/logs/metrics land in OpenObserve UI at http://127.0.0.1:5080
# CELLP_OTEL_BACKEND=jaeger is the query-facade backend flag only; MacPanel OO setup has no Jaeger/Tempo API.
# View traces in OpenObserve UI — NOT cellp Dashboard → Telemetry tab.
CELLP_OTEL_BACKEND=jaeger
CELLP_OTEL_COLLECTOR=http://otel-collector:4318

# After editing cellp/.env:
#   cd compose/cellp && docker compose up -d --force-recreate cellpd
